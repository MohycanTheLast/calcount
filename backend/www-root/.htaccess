# Nastavení výchozího souboru, upřednostňuje index.html před index.php
DirectoryIndex index.html index.php

# Bezpečnostní hlavičky (platí pro SPA i API)
<IfModule mod_headers.c>
    # CSP: skripty, styly a požadavky jen z vlastní domény. 'unsafe-inline' u skriptů kvůli inline skriptům
    # z buildu Nuxtu (téma v <head>, __NUXT__ konfigurace) – mění se s každým buildem, hash by nešel udržet.
    # Až přibude přihlášení přes Google/Apple, doplnit jejich domény (script-src, frame-src, connect-src).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
    # HSTS jen přes HTTPS (lokálně běží http)
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forward Authorization header to PHP (needed for Bearer JWT in some Apache setups)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Určíme základní adresář automaticky
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    # Přesměrování požadavku na index.html, pokud existuje
    RewriteCond %{REQUEST_URI} ^/?$
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^ index.html [L]

    # Přesměrování bez /index.php k prevenci duplicíty
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # SPA fallback pro Nuxt (aplikace je pod /app, /calendar, /settings a /day/<datum>)
    # Pokud existuje index.html v docrootu, přesměruj SPA routy na něj.
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^(app|calendar|settings|day)(/.*)?$ index.html [L]

    # Pokud soubor neexistuje, přesměruj na index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        # Dočasné přesměrování na index.php, pokud mod_rewrite není dostupný
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>
